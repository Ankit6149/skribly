{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skribli",
  "version": "0.1.3",
  "identifier": "app.skribly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skribli",
        "width": 420,
        "height": 360,
        "minWidth": 320,
        "minHeight": 260,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": false,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Contextual notes that live inside your applications.",
    "longDescription": "Skribli is a local-first contextual note utility for Windows. Press the shortcut, write one note, and close it without leaving anything floating over the rest of your screen.",
    "copyright": "Copyright © 2026 Ankit Bhardwaj"
  }
}
