{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skribli",
  "version": "0.1.11",
  "identifier": "app.skribly.desktop",
  "mainBinaryName": "skribly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "home",
        "title": "Skribli",
        "width": 880,
        "height": 620,
        "minWidth": 720,
        "minHeight": 540,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true
      },
      {
        "label": "main",
        "title": "Skribli Compact Editor",
        "width": 420,
        "height": 360,
        "minWidth": 320,
        "minHeight": 260,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": false,
        "fullscreen": false,
        "maximized": false
      },
      {
        "label": "library",
        "title": "All Skribs — Skribli",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "category": "Productivity",
    "shortDescription": "A contextual annotation layer for Windows.",
    "longDescription": "Skribli is a local-first contextual annotation application for Windows with typed and handwritten Skribs, pastel notes, local attachments, reminders, and a calendar that return with their context.",
    "copyright": "Copyright © 2026 Ankit Bhardwaj"
  }
}
