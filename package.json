{
  "name": "skribly",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "npm --workspace @skribly/desktop run dev",
    "tauri": "npm --workspace @skribly/desktop run tauri --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm --workspace @skribly/desktop run lint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "react-runtime:validate": "node scripts/validation/validate-react-runtime.mjs",
    "desktop-theme:validate": "node scripts/validation/validate-desktop-theme.mjs",
    "desktop-theme:order:test": "node --test scripts/validation/desktop-css-order.test.mjs",
    "compact-surface:validate": "node scripts/validation/validate-compact-surface.mjs",
    "site:validate": "node site/validate.mjs && node --test site/interface-lab-contract.test.mjs site/api/checkout.test.cjs site/v0-download.test.mjs",
    "governance:validate": "node scripts/governance/validate-repository.mjs",
    "product-truth:validate": "node scripts/validation/validate-product-truth.mjs && node scripts/validation/validate-note-lifecycle.mjs && node scripts/validation/validate-library-window.mjs && node scripts/validation/validate-trash-lifecycle.mjs && node scripts/validation/validate-trash-migration-fixture.mjs && node scripts/validation/validate-portable-import.mjs",
    "private-test-artifact:validate": "node scripts/validation/validate-private-test-artifact-workflow.mjs",
    "license:keypair": "node scripts/license/generate-keypair.mjs",
    "license:issue": "node scripts/license/issue-license.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
