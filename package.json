{
  "name": "skribly",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "npm --workspace @skribly/desktop run dev",
    "tauri": "npm --workspace @skribly/desktop run tauri",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "site:validate": "node site/validate.mjs",
    "license:keypair": "node scripts/license/generate-keypair.mjs",
    "license:issue": "node scripts/license/issue-license.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
